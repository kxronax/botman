# =============================================================================
# Telegram credentials  (REQUIRED)
# Get them at https://my.telegram.org -> "API development tools".
# API_HASH is a secret: never commit it, never share it.
# =============================================================================
API_ID=
API_HASH=

# Your phone number in international format. Optional — you will be asked for
# it interactively on the first run if it is missing.
PHONE=

# Name of the session file stored in data/session/. Change it only if you run
# several archivers from the same directory.
SESSION_NAME=archiver

# Portable session, used INSTEAD of the session file on hosts without a
# persistent disk (see the Railway section of the README). Generate it with
#   python main.py --export-session
# It grants full access to your account — treat it exactly like a password.
SESSION_STRING=

# =============================================================================
# Archive chat
# The private chat/channel that receives copies. Leave empty to archive
# locally only. How to find the id: see README, "Setting up the archive chat".
# Channels and supergroups have ids starting with -100.
# =============================================================================
ARCHIVE_CHAT_ID=
SEND_TO_ARCHIVE_CHAT=true

# Seconds to pause after each archive-chat message. Raise it if you hit
# FloodWait often.
ARCHIVE_SEND_DELAY=1.0

# =============================================================================
# Storage
# =============================================================================
# Where the database, media and logs live. On Railway point this at a volume.
DATA_DIR=data

# Leave empty for SQLite in DATA_DIR. To use PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=

# Download media files to disk.
DOWNLOAD_MEDIA=true

# Files bigger than this are not downloaded; their metadata is still archived.
# Set to 0 for no limit (beware: Telegram allows files up to 2 GB, 4 GB on Premium).
MAX_MEDIA_SIZE_MB=512

# =============================================================================
# What to archive
# =============================================================================
ARCHIVE_OUTGOING=true
ARCHIVE_PRIVATE=true
ARCHIVE_GROUPS=true
ARCHIVE_CHANNELS=true

# Comma-separated chat ids. INCLUDE_CHATS, when set, restricts archiving to
# exactly those chats. EXCLUDE_CHATS always wins.
INCLUDE_CHATS=
EXCLUDE_CHATS=

# =============================================================================
# Initial import (python main.py --import)
# =============================================================================
# Messages per chat. Set to 0 for the entire history (slow on big accounts).
IMPORT_LIMIT_PER_CHAT=200

# How many chats to walk. 0 = all of them.
IMPORT_CHAT_LIMIT=0

# Download media during the import as well.
IMPORT_MEDIA=true

# Also push every imported message into the archive chat. Off by default:
# importing thousands of old messages into a chat is slow and floods it.
IMPORT_SEND_TO_ARCHIVE_CHAT=false

# =============================================================================
# Reliability and logging
# =============================================================================
# Telethon sleeps through FloodWaits shorter than this by itself.
FLOOD_SLEEP_THRESHOLD=60
MAX_RETRIES=5

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
